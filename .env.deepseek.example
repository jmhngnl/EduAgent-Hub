APP_NAME=EduAgent Hub
ENVIRONMENT=production
LOG_LEVEL=INFO

# Internal Java -> Python runtime key. Never expose this in the browser.
PLATFORM_INTERNAL_API_KEY=replace-with-long-random-internal-key

DATABASE_URL=postgresql://eduagent:eduagent@postgres:5432/eduagent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MOCK_LLM=false
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_TIMEOUT_SECONDS=20
PAPER_SEARCH_MAX_RESULTS=8
SKILLS_DIR=skills

MOCK_EMBEDDINGS=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
MAX_USER_INPUT_CHARS=12000

# V2.2.1 Memory / Context Management
CONTEXT_MAX_INPUT_TOKENS=16000
CONTEXT_RESERVED_OUTPUT_TOKENS=2500
CONTEXT_SYSTEM_RESERVE_TOKENS=2200
CONTEXT_RECENT_HISTORY_TOKENS=4500
CONTEXT_SUMMARY_MAX_TOKENS=1800
CONTEXT_SUMMARY_SOURCE_TOKENS=7000
CONTEXT_RAG_TOKENS=5000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eduagent-hub
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=http://192.168.150.101:5173
UPLOAD_DIR=/tmp/eduagent_uploads
MAX_UPLOAD_MB=30
DEFAULT_WORKSPACE_ID=demo

PLATFORM_SERVER_PORT=8081
PLATFORM_MYSQL_DATABASE=eduagent_platform
PLATFORM_MYSQL_USER=eduagent
PLATFORM_MYSQL_PASSWORD=eduagent
PLATFORM_MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
PLATFORM_JWT_SECRET=replace-with-at-least-32-random-characters-0123456789
PLATFORM_JWT_ISSUER=eduagent-hub
PLATFORM_ACCESS_TOKEN_MINUTES=30
PLATFORM_REFRESH_TOKEN_DAYS=7
PLATFORM_REFRESH_COOKIE_SECURE=false
# Optional first OWNER. Leave blank to let the first registered user own demo.
PLATFORM_BOOTSTRAP_USERNAME=
PLATFORM_BOOTSTRAP_PASSWORD=
PLATFORM_BOOTSTRAP_DISPLAY_NAME=Platform Owner
