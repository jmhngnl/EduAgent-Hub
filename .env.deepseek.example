APP_NAME=EduAgent Hub
ENVIRONMENT=production
LOG_LEVEL=INFO

# Project access key used by the Web UI. Do not put your DeepSeek key here.
API_KEYS=demo
API_KEY_WORKSPACES=demo:demo

DATABASE_URL=postgresql://eduagent:eduagent@postgres:5432/eduagent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# DeepSeek ChatCompletions configuration. Keep this file only on the server.
MOCK_LLM=false
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# DeepSeek chat can be used while RAG keeps the local deterministic demo
# embeddings. Configure a dedicated embedding provider later for production.
MOCK_EMBEDDINGS=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
MAX_HISTORY_MESSAGES=16
MAX_USER_INPUT_CHARS=12000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eduagent-hub
OTEL_EXPORTER_OTLP_ENDPOINT=

CORS_ORIGINS=http://192.168.150.101:5173
UPLOAD_DIR=/tmp/eduagent_uploads
MAX_UPLOAD_MB=30
DEFAULT_WORKSPACE_ID=demo
