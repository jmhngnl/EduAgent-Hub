APP_NAME=EduAgent Hub
ENVIRONMENT=development
LOG_LEVEL=INFO

# EduAgent Hub application authentication.
# The browser sends this value as X-API-Key. It is NOT an LLM provider key.
API_KEYS=demo-key
API_KEY_WORKSPACES=demo-key:demo

DATABASE_URL=postgresql://eduagent:eduagent@postgres:5432/eduagent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Chat model. Provider credentials stay on the server and are never entered
# into the browser connection dialog.
MOCK_LLM=true
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Academic paper discovery. Semantic Scholar API key is optional but recommended.
SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_TIMEOUT_SECONDS=20
PAPER_SEARCH_MAX_RESULTS=8
SKILLS_DIR=skills

# Embeddings are independent from the chat model.
# Keep true for the offline/demo deterministic embedding implementation.
MOCK_EMBEDDINGS=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
MAX_HISTORY_MESSAGES=16
MAX_USER_INPUT_CHARS=12000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eduagent-hub

OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=/tmp/eduagent_uploads
MAX_UPLOAD_MB=30
DEFAULT_WORKSPACE_ID=demo
