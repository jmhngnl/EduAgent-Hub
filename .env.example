APP_NAME=EduAgent Hub
ENVIRONMENT=development
LOG_LEVEL=INFO

# Leave empty for local development. Use comma-separated values in deployment.
API_KEYS=
# Optional: demo-key:demo,team-a-key:team-a
API_KEY_WORKSPACES=

DATABASE_URL=postgresql://eduagent:eduagent@postgres:5432/eduagent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# The complete project can run without an external model in mock mode.
MOCK_LLM=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
MAX_HISTORY_MESSAGES=16
MAX_USER_INPUT_CHARS=12000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eduagent-hub

OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=/tmp/eduagent_uploads
MAX_UPLOAD_MB=30
DEFAULT_WORKSPACE_ID=demo
